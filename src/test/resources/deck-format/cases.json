 "cards": [
  {
   "name": "minimal card",
   "fields": {
    "front": "猫",
    "back": "mèo"
   },
   "expect": "ok",
   "front": "猫",
   "reading": ""
  },
  {
   "name": "furigana markup is stripped and becomes the reading",
   "fields": {
    "front": "勉強[べんきょう]する",
    "back": "học"
   },
   "expect": "ok",
   "front": "勉強する",
   "reading": "べんきょうする"
  },
  {
   "name": "reading given as markup is reduced to kana",
   "fields": {
    "front": "立場",
    "back": "vị thế",
    "frontReading": "立場[たちば]"
   },
   "expect": "ok",
   "front": "立場",
   "reading": "たちば"
  },
  {
   "name": "explicit reading wins over markup",
   "fields": {
    "front": "学校[がっこう]",
    "back": "trường",
    "frontReading": "がっこう "
   },
   "expect": "ok",
   "front": "学校",
   "reading": "がっこう"
  },
  {
   "name": "html is left alone",
   "fields": {
    "front": "<b>学校[がっこう]</b>",
    "back": "trường"
   },
   "expect": "ok",
   "front": "<b>学校[がっこう]</b>",
   "reading": ""
  },
  {
   "name": "malformed markup is kept as written",
   "fields": {
    "front": "学校[がっこう",
    "back": "trường"
   },
   "expect": "ok",
   "front": "学校[がっこう",
   "reading": ""
  },
  {
   "name": "whitespace is trimmed and blanks dropped",
   "fields": {
    "front": "  猫  ",
    "back": "mèo",
    "notes": "   "
   },
   "expect": "ok",
   "front": "猫",
   "reading": ""
  },
  {
   "name": "examples are accepted",
   "fields": {
    "front": "猫",
    "back": "mèo",
    "examples": [
     {
      "japanese": "猫です。",
      "meaning": "Là mèo."
     }
    ]
   },
   "expect": "ok",
   "front": "猫",
   "reading": ""
  },
  {
   "name": "missing back",
   "fields": {
    "front": "猫"
   },
   "expect": "error"
  },
  {
